---
import type { MarkdownInstance } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import LanguageSwitch from './LanguageSwitch.astro';

interface Props { lang: 'en' | 'vi'; }
interface Article {
  title: string;
  description: string;
  published: string;
  category: string;
  lang?: 'en' | 'vi';
  draft?: boolean;
}
const { lang } = Astro.props;
const modules = lang === 'vi'
  ? import.meta.glob<MarkdownInstance<Article>>('../pages/vi/writing/*.md', { eager: true })
  : import.meta.glob<MarkdownInstance<Article>>('../pages/writing/*.md', { eager: true });
const articles = Object.values(modules)
  .filter((article) => !article.frontmatter.draft)
  .sort((a, b) => b.frontmatter.published.localeCompare(a.frontmatter.published)
    || a.frontmatter.title.localeCompare(b.frontmatter.title, lang));
const copy = lang === 'vi' ? {
  title: 'Bài viết — Thanh Pham',
  label: 'Bài viết',
  heading: 'Ghi chép kỹ thuật và nghiên cứu bảo mật.',
  description: 'Phân tích nguyên nhân, bằng chứng thử nghiệm, ranh giới tin cậy và kết quả công bố.',
  list: 'Các bài viết',
  read: 'Đọc bài viết →',
} : {
  title: 'Writing — Thanh Pham',
  label: 'Writing',
  heading: 'Technical notes and security research.',
  description: 'Root causes, controlled evidence, trust boundaries, and disclosure outcomes.',
  list: 'Articles',
  read: 'Read article →',
};
---

<BaseLayout title={copy.title} description={copy.description} {lang}>
  <Fragment slot="head">
    <link rel="alternate" hreflang="en" href={new URL('/writing/', Astro.site)} />
    <link rel="alternate" hreflang="vi" href={new URL('/vi/writing/', Astro.site)} />
    <link rel="canonical" href={new URL(lang === 'vi' ? '/vi/writing/' : '/writing/', Astro.site)} />
  </Fragment>
  <main class="wrap page-shell">
    <header class="page-header">
      <div class="index-navigation">
        <div class="eyebrow"><span class="n">//</span> {copy.label}</div>
        <LanguageSwitch {lang} englishPath="/writing/" vietnamesePath="/vi/writing/" />
      </div>
      <h1>{copy.heading}</h1>
      <p>{copy.description}</p>
    </header>
    <section class="writing-list" aria-labelledby="published-writing">
      <h2 id="published-writing">{copy.list}</h2>
      <div class="writing-cards">
        {articles.map(({ frontmatter, url }) => (
          <a class="writing-card" href={url}>
            <div class="writing-meta">{frontmatter.category} · {frontmatter.published}</div>
            <h3>{frontmatter.title}</h3>
            <p>{frontmatter.description}</p>
            <span class="writing-link">{copy.read}</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
