---
interface Props { lang?: 'en' | 'vi'; }
const { lang = 'en' } = Astro.props;
---

<footer>
  <div class="wrap">
    © <span id="yr">2026</span> Thanh Pham · {lang === 'vi' ? 'Mọi hoạt động đánh giá đều có ủy quyền bằng văn bản' : 'All engagements under written authorization'}
  </div>
</footer>

<script is:inline>
  document.getElementById('yr').textContent = new Date().getFullYear();
</script>
